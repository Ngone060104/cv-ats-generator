PORT=3000

# Clé créée dans la Claude Console (commence par sk-ant-)
ANTHROPIC_API_KEY=remplace_par_ta_cle_api
CLAUDE_MODEL=claude-sonnet-5-5

# PostgreSQL : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@localhost:5432/cv_ats

# Génère une valeur avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplace_par_une_longue_valeur_aleatoire

# Passe à false une fois ton compte créé, pour fermer les inscriptions
ALLOW_REGISTRATION=true

# --- Optionnel (valeurs par défaut sûres) ---
# Adresse du front autorisée par CORS (Angular en dev)
# CORS_ORIGIN=http://localhost:4200
# Limites (par 15 min / par heure) : RATE_LIMIT_GLOBAL=600, RATE_LIMIT_LOGIN_FAILS=10, RATE_LIMIT_REGISTER=10, RATE_LIMIT_GENERATE=30
